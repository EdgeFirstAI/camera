# EdgeFirst Camera Configuration
#
# This file is loaded by the systemd service as an EnvironmentFile. Every
# variable here maps to a command-line flag of the same name (lower-case,
# with dashes replaced by underscores). Command-line flags take precedence
# over environment variables.
#
# Syntax rules (systemd EnvironmentFile):
#   - Lines beginning with # or ; are comments.
#   - KEY=VALUE pairs, one per line.
#   - Quoting is optional; quotes are stripped by systemd.
#   - No spaces around the '=' sign.

# ---------------------------------------------------------------------------
# Frame Source
# ---------------------------------------------------------------------------
# Where frames come from. One of:
#   /dev/videoN            a V4L2 camera device
#   file:<name>.h264       a recording made with RECORD, with its <name>.json
#   mock[:WxH@fps]         synthetic frames, for testing without a camera
# Leave empty to use CAMERA.
SOURCE=""

# V4L2 device path for the camera, used when SOURCE is empty. On Maivin boards
# video3 is typically the ISP output.
CAMERA="/dev/video3"

# How capture buffers are allocated: "import" this service's contiguous
# buffers, "export" the driver's own, or "auto" to import and fall back to the
# driver's buffers when it refuses them.
MEMORY="auto"

# libcamera pipeline selection, i.MX 95 only. Makes libcamera use the nxp/neo
# ISP pipeline instead of the raw-only imx8-isi one. On other platforms, such
# as the Raspberry Pi 5, it hides the camera, so leave it commented out there.
#LIBCAMERA_PIPELINES_MATCH_LIST="nxp/neo"

# ---------------------------------------------------------------------------
# Camera Capture
# ---------------------------------------------------------------------------
# Size and rate are requests: the camera applies what it can, and the service
# logs what was applied.

# Capture resolution requested from the camera (width height). Leave empty to
# keep the camera's current size.
CAMERA_SIZE=""

# Capture rate requested from the camera, in frames per second. Leave empty to
# keep the camera's current rate. For a file: source, the playback rate
# (empty plays at the recorded rate).
CAMERA_FPS=""

# Capture mode shorthand for CAMERA_SIZE plus CAMERA_FPS, case-insensitive:
#   VGA, WVGA, 540p, 720p, 1080p or 4K followed by the rate, e.g. 1080p30.
#   Sizes: VGA 640x480, WVGA 800x480, 540p 960x540, 720p 1280x720,
#   1080p 1920x1080, 4K 3840x2160.
# Accepted only when the camera reports that size and rate; otherwise the
# service fails to start and lists the modes the camera offers. CAMERA_SIZE
# and CAMERA_FPS win over it when set. The rate-only form (30FPS) is no longer
# accepted; use CAMERA_FPS. Product images such as Maivin set
# CAMERA_MODE=1080p30 via a bbappend, not this file.
CAMERA_MODE=""

# Number of capture buffers (2-32). Every frame published on FRAME_TOPIC
# references one of these DMA buffers, which the camera overwrites once the
# frames queued ahead of it are captured. Subscribers such as the model and
# fusion services must read a frame within about (CAMERA_BUFFERS - 1) frame
# periods: 100 ms with 4 buffers at 30 FPS, but only 50 ms at 60 FPS. More
# buffers give subscribers more time and add no latency while this service
# keeps up; each one costs one capture frame of CMA memory (about 4 MB at
# 1080p YUYV). Use 6 or more when downstream services pair frames with slower
# sensors such as radar. The service adds two buffers of its own while H264,
# H264_TILES or JPEG is on, for frames waiting for its encoders. Leave empty
# for the default of 4.
CAMERA_BUFFERS=""

# Camera controls: "auto", or a fixed value. Leave empty to keep the camera's
# setting. A camera that does not offer a control logs a warning.
# Exposure time in microseconds.
EXPOSURE=""
# Analogue gain multiplier.
GAIN=""
# White balance colour temperature in kelvin.
WHITE_BALANCE=""

# ---------------------------------------------------------------------------
# Streaming Resolution
# ---------------------------------------------------------------------------
# Resolution used for H.264 and JPEG encoding output (width height), no larger
# than the capture size. The hardware H.264 encoder supports up to 1920x1080; a
# larger capture (e.g. 4K) is downscaled to STREAM_SIZE for the main stream,
# and H264_TILES is turned on to publish it at full resolution.
STREAM_SIZE="1920 1080"

# ---------------------------------------------------------------------------
# Mirror Setting
# ---------------------------------------------------------------------------
# Flip the camera image so it is published in its natural orientation
# (upright, as a person would view the scene). This setting exists only to
# undo how the sensor is mounted; it is not a display effect.
#
# Maivin and Raivin mount the sensor upside down, so both axes (vflip+hflip,
# a 180-degree rotation) are enabled by default.
#
# Fusion and other downstream consumers assume the published image is in its
# natural orientation. The camera transform (CAM_TF_VEC, CAM_TF_QUAT) and
# calibration (CAM_INFO_PATH) describe the natural image and must not encode
# this mount rotation. Mirroring for display belongs in the WebUI view.
# Accepted values: none, horizontal, vertical, both
MIRROR="both"

# ---------------------------------------------------------------------------
# H.264 Streaming
# ---------------------------------------------------------------------------
# Enable H.264 video output on the Zenoh topic camera/h264.
# The stream uses hardware encoding when available. This is also the
# built-in default, so a manually launched camera publishes video too.
H264="true"

# H.264 encoding bitrate preset. Higher bitrates improve quality but
# increase bandwidth and storage requirements.
# Accepted values: auto, mbps5, mbps25, mbps50, mbps100
# "auto" selects a bitrate based on the stream resolution.
H264_BITRATE="auto"

# ---------------------------------------------------------------------------
# H.264 4K Tiling
# ---------------------------------------------------------------------------
# When the camera captures at 4K, the hardware encoder is limited to 1080p.
# Enabling tiles splits each 4K frame into 4 non-overlapping 1080p quadrants
# and encodes each independently. The four tile streams are published on
# separate Zenoh topics (camera/h264/tl, camera/h264/tr, camera/h264/bl,
# camera/h264/br).
# Only useful when capture is 3840x2160 or larger.
H264_TILES="false"

# FPS limit applied to tile streams. A lower value than the camera FPS
# reduces compression artifacts and total bandwidth when tiling is active.
# 0 means no limit: every captured frame is offered to each tile encoder.
H264_TILES_FPS="15"

# ---------------------------------------------------------------------------
# JPEG Streaming
# ---------------------------------------------------------------------------
# Enable JPEG snapshot output on the Zenoh topic camera/jpeg.
# Useful for low-bandwidth preview or single-frame consumers.
JPEG="false"

# JPEG encoding quality, 1-100. 85 is visually equivalent to 100 for
# slightly less work.
#
# Note that quality is a weak lever on cost. Measured at 1080p30 on a
# Verdin iMX8MP, enabling JPEG takes the camera process from 27% to 104%
# CPU, and dropping quality from 100 to 85 recovers only about 3 of those
# 77 points -- the cost is dominated by the per-frame conversion and DCT,
# not the entropy coding. If JPEG streaming is too expensive, reduce
# STREAM_SIZE or turn JPEG off; there is no hardware JPEG encoder on this
# platform to fall back on.
JPEG_QUALITY="85"

# ---------------------------------------------------------------------------
# Recording and Replay
# ---------------------------------------------------------------------------
# Record the H.264 stream to a file, as raw Annex-B. Requires H264 and a
# camera source. A matching <name>.json sidecar is written alongside at
# startup carrying colorimetry, camera/info and tf_static -- the producer
# state that is not recoverable from the bitstream.
#
# WARNING: this writes continuously for as long as the service runs, with
# no size cap and no rotation. Left set in this file it will fill the
# filesystem. Set it for a capture session and clear it afterwards; it is
# not intended as a persistent setting.
RECORD=""

# To replay a recording instead of opening the camera, set
# SOURCE="file:<name>.h264". The recording's H.264 is republished as recorded,
# its frames are decoded for FRAME_TOPIC and JPEG, and camera/info and
# tf_static come from its sidecar. MIRROR and STREAM_SIZE do not apply.

# Loop a file: source back to the start at its end instead of exiting. The
# frame sequence counter keeps incrementing across loops so consumers see one
# continuous stream, as they would from a live camera.
REPLAY_LOOP="false"

# Playback rate of a file: source; the 2.x name of CAMERA_FPS, which wins when
# both are set. Empty uses the rate recorded in the sidecar.
REPLAY_FPS=""

# ---------------------------------------------------------------------------
# Camera Calibration
# ---------------------------------------------------------------------------
# Path to a camera calibration JSON file (isp-imx format). When provided,
# the node publishes sensor_msgs/CameraInfo on camera/info using that
# file's geometry. Leave empty if no calibration file is available.
#
# camera/info is published either way. If this path is set but cannot be
# loaded, the node logs a warning and falls back to built-in defaults
# rather than failing to start -- those defaults are nominal for a 1080p
# sensor and describe no particular lens, so they are not valid for
# projection or sensor fusion. Check the log if calibration matters.
CAM_INFO_PATH=""

# ---------------------------------------------------------------------------
# Camera Transform (TF)
# ---------------------------------------------------------------------------
# Static transform from the robot base_link frame to the camera optical
# frame, published as a TF message. These values define the physical
# mounting position and orientation of the camera on the robot, as
# calibrated for the natural-orientation image produced after MIRROR. Do
# not use them to describe an upside-down or flipped mount; MIRROR handles
# that.

# Translation vector (x y z) in meters from base_link to camera_optical.
CAM_TF_VEC="0 0 0"

# Rotation quaternion (x y z w) from base_link to camera_optical.
# The default represents a typical forward-facing camera rotation.
CAM_TF_QUAT="-1 1 -1 1"

# TF frame IDs for the two ends of the transform above. The camera frame
# ID is also stamped into the header of every published frame.
BASE_FRAME_ID="base_link"
CAMERA_FRAME_ID="camera_optical"

# ---------------------------------------------------------------------------
# Zenoh Topics
# ---------------------------------------------------------------------------
# Key expressions the node publishes on. All keys are relative to the
# session namespace, which is the system hostname, so the wire form of
# camera/frame is {hostname}/camera/frame. Change these only when
# integrating with a consumer that expects different names.

# Multi-plane camera frame (edgefirst_msgs/CameraFrame).
FRAME_TOPIC="camera/frame"

# Camera calibration (sensor_msgs/CameraInfo). See CAM_INFO_PATH above.
INFO_TOPIC="camera/info"

# JPEG compressed images (sensor_msgs/CompressedImage). Requires JPEG.
JPEG_TOPIC="camera/jpeg"

# H.264 video stream (foxglove_msgs/CompressedVideo). Requires H264.
H264_TOPIC="camera/h264"

# The four 4K tile streams, in order: top-left, top-right, bottom-left,
# bottom-right. Space separated, exactly four entries. Requires
# H264_TILES.
H264_TILES_TOPICS="camera/h264/tl camera/h264/tr camera/h264/bl camera/h264/br"

# ---------------------------------------------------------------------------
# Zenoh Networking
# ---------------------------------------------------------------------------
# Zenoh participant mode. In "peer" mode nodes discover each other via
# multicast. Use "client" to connect to a Zenoh router, or "router" to act
# as one.
# Accepted values: peer, client, router
MODE="peer"

# Zenoh endpoint(s) to connect to. Required when MODE is "client".
# Example: CONNECT="tcp/192.168.1.1:7447"
CONNECT=""

# Zenoh endpoint(s) to listen on. Useful when running as a router or when
# peers need to reach this node on a specific address/port.
LISTEN=""

# Disable Zenoh multicast scouting (peer auto-discovery). Set to true when
# operating in networks where multicast is unavailable or undesired, and use
# CONNECT/LISTEN for explicit endpoint configuration instead.
NO_MULTICAST_SCOUTING="false"

# ---------------------------------------------------------------------------
# Debugging / Profiling
# ---------------------------------------------------------------------------
# Enable the Tokio async runtime console (tokio-console). Requires the
# binary to be built with the tokio_unstable cfg flag.
TOKIO_CONSOLE="false"

# Enable the Tracy profiler for real-time performance analysis. Requires the
# binary to be built with Tracy support.
TRACY="false"
